# ============================================================
# Environment Variables — Copy this file to .env and fill in
# ============================================================

# --- LLM Providers ---
# Get your free Groq key at: https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Get your free NVIDIA NIM key at: https://build.nvidia.com
NVIDIA_API_KEY="your_nvidia_api_key_here"

# --- Qdrant Cloud ---
# Create a free cluster at: https://cloud.qdrant.io
QDRANT_URL="https://your-cluster-id.cloud.qdrant.io"
QDRANT_API_KEY="your_qdrant_api_key_here"

# --- Google Cloud (Vertex AI + Cloud Storage) ---
# Gemini models are served via Vertex AI — auth uses a service account JSON,
# NOT a Gemini API key. Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS="path/to/your/gcp-service-account.json"

# GCS bucket name for storing the dataset CSV and BM25 pickle index
GCP_BUCKET_NAME="your-gcs-bucket-name"

# --- LangSmith Tracing (optional) ---
# Enables full LangGraph agent tracing at: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="perfume-sommelier"

# --- Ingestion Webhook (optional) ---
# A secret token to protect the POST /api/ingest webhook endpoint.
# If not set, the /api/ingest endpoint will return 503.
# Your data pipeline script must send this token in the x-ingest-token header.
INGEST_TOKEN="choose_any_strong_random_string"
